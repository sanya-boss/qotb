{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/surfaces/**",
              "components/typography/**",
              "ui_kits/website-luxe/**",
              "ui_kits/website-sea/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cane Nero|Cormorant|Jost|Marcellus|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Cane Nero, Cormorant, Jost, Marcellus, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tone|size|href|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, tone, size, href, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid)$/]",
        "message": "<Button> variant must be one of 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Button> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|onChange|name|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, onChange, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeaturePanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:media|src|circle|title|tail|children|actions|key|ref|className|style|children)$/]",
        "message": "<FeaturePanel> doesn't accept that prop. Declared props: media, src, circle, title, tail, children, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<FilterTabs> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|label|size|tone|key|ref|className|style|children)$/]",
        "message": "<IconCircle> doesn't accept that prop. Declared props: name, href, label, size, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconCircle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<IconCircle> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndexLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|label|style|key|ref|className|style|children)$/]",
        "message": "<IndexLabel> doesn't accept that prop. Declared props: n, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lead'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|align|size|style|key|ref|className|style|children)$/]",
        "message": "<Lead> doesn't accept that prop. Declared props: children, tone, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lead'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Lead> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lead'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Lead> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lead'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<Lead> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|right|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: left, right, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|href|maxHeight|key|ref|className|style|children)$/]",
        "message": "<LogoItem> doesn't accept that prop. Declared props: src, name, href, maxHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|separator|tone|speed|key|ref|className|style|children)$/]",
        "message": "<Marquee> doesn't accept that prop. Declared props: text, separator, tone, speed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marquee'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Marquee> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:media|src|meta|title|subtitle|ratio|href|onClick|key|ref|className|style|children)$/]",
        "message": "<MediaCard> doesn't accept that prop. Declared props: media, src, meta, title, subtitle, ratio, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|hover|as|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, padding, hover, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|article|section|a)$/]",
        "message": "<Panel> as must be one of 'div' | 'article' | 'section' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerFeature'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|logoHeight|name|role|description|href|invert|key|ref|className|style|children)$/]",
        "message": "<PartnerFeature> doesn't accept that prop. Declared props: logo, logoHeight, name, role, description, href, invert."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoCollage'] > JSXAttribute > JSXIdentifier[name!=/^(?:photos|children|height|key|ref|className|style|children)$/]",
        "message": "<PhotoCollage> doesn't accept that prop. Declared props: photos, children, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|author|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: title, children, author."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|rule|align|tone|size|as|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: title, eyebrow, rule, align, tone, size, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionHeading> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|lg|md|sm)$/]",
        "message": "<SectionHeading> size must be one of 'xl' | 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeading> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|options|value|defaultValue|onChange|required|error|placeholder|key|ref|className|style|children)$/]",
        "message": "<SelectField> doesn't accept that prop. Declared props: label, name, options, value, defaultValue, onChange, required, error, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:assetsBase|links|phone|email|onNavigate|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: assetsBase, links, phone, email, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|type|value|defaultValue|placeholder|onChange|required|error|hint|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, name, type, value, defaultValue, placeholder, onChange, required, error, hint, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|arrow|tone|size|onClick|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: children, href, arrow, tone, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<TextLink> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<TextLink> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|visual|title|badge|children|href|key|ref|className|style|children)$/]",
        "message": "<Tile> doesn't accept that prop. Declared props: icon, visual, title, badge, children, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|height|assetsBase|alt|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: variant, tone, height, assetsBase, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:wordmark|mermaid|monogram|figure|crown)$/]",
        "message": "<Wordmark> variant must be one of 'wordmark' | 'mermaid' | 'monogram' | 'figure' | 'crown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|light)$/]",
        "message": "<Wordmark> tone must be one of 'navy' | 'light'."
      }
    ]
